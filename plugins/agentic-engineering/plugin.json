{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agentic-engineering",
  "version": "0.3.0",
  "description": "Claude Code と Codex のコンテキスト管理、プロジェクト自動発見、並列化、長期タスク、GitHub Stacked PR を自動選択する汎用ソフトウェア開発オーケストレーション",
  "author": {
    "name": "Agentic Engineering Maintainers",
    "url": "https://github.com/calorie"
  },
  "homepage": "https://github.com/calorie/agentic-engineering",
  "repository": "https://github.com/calorie/agentic-engineering",
  "keywords": [
    "software-engineering",
    "orchestration",
    "context-management",
    "subagents",
    "worktree",
    "stacked-pr"
  ],
  "extensions": {
    "com.openai": {
      "hooks": [
        "./hooks/hooks.codex.json"
      ],
      "interface": {
        "displayName": "Agentic Engineering",
        "shortDescription": "Autonomous software-engineering orchestration",
        "longDescription": "Keep the root context lean while automatically selecting subagents, worktrees, long-task state, review, verification, and GitHub stacked pull requests.",
        "developerName": "Agentic Engineering Maintainers",
        "category": "Productivity",
        "capabilities": ["Read", "Write"]
      }
    }
  }
}
